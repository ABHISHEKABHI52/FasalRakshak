# FasalRakshak — environment template (docs/15 §2)
# Copy to .env and fill in real values. NEVER commit .env.
# Production values must come from a secret store / CI secrets (docs/12 §4).

# ---- Application ----
ENV=development                       # development | staging | production
LOG_LEVEL=INFO

# ---- Database (PostgreSQL + PostGIS + pgvector in deployment) ----
# Container-to-container uses the compose service name `db` — never localhost (docs/15 §1).
DATABASE_URL=postgresql+asyncpg://fasalrakshak:change-me-db-password@db:5432/fasalrakshak
# Local backend-only development without Docker may use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./fasalrakshak_dev.db

# Compose database service (must match DATABASE_URL credentials above)
POSTGRES_USER=fasalrakshak
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=fasalrakshak

# ---- Security / JWT (min 32 chars — RFC 7518 §3.2) ----
JWT_SECRET=replace-with-a-32-plus-character-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- CORS (comma-separated explicit origins; no wildcards with credentials) ----
CORS_ORIGINS=http://localhost:3000

# ---- Auth rate limiting (app-level; nginx adds global limits in deployment) ----
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Frontend (Next.js build-time public config) ----
NEXT_PUBLIC_API_URL=http://localhost:8000